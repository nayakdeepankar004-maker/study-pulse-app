rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             data.board in ['CBSE', 'ICSE', 'BSE Odisha', 'Other State Boards'] &&
             data.studentClass in ['Class 6', 'Class 7', 'Class 8', 'Class 9', 'Class 10', 'Class 11', 'Class 12'] &&
             data.stream in ['Science PCM', 'Science PCB', 'Commerce', 'Arts/Humanities', 'Foundation'] &&
             data.targetExam in ['Board Exams', 'NEET', 'JEE Main', 'Foundation'] &&
             data.onboardingCompleted is bool &&
             data.totalTestsTaken is int && data.totalTestsTaken >= 0 && data.totalTestsTaken <= 100000 &&
             data.bestAccuracy is int && data.bestAccuracy >= 0 && data.bestAccuracy <= 100 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000;
    }

    function isValidStudyNote(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.content is string && data.content.size() <= 10000 &&
             data.pinned is bool;
    }

    function isValidPdfDocument(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.uriString is string && data.uriString.size() >= 1 && data.uriString.size() <= 1000 &&
             data.pageCount is int && data.pageCount >= 0 && data.pageCount <= 50000;
    }

    function isValidTestAttempt(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.track in ['Board Exams', 'NEET', 'JEE Main', 'Foundation', 'AI Generated'] &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalQuestions &&
             data.score is int && data.score >= -200 && data.score <= 800 &&
             data.maxScore is int && data.maxScore >= 1 && data.maxScore <= 800 &&
             data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'board', 'studentClass', 'stream',
                         'targetExam', 'onboardingCompleted', 'totalTestsTaken',
                         'bestAccuracy', 'streakDays', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'board', 'studentClass', 'stream',
                         'targetExam', 'onboardingCompleted', 'totalTestsTaken',
                         'bestAccuracy', 'streakDays', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'board', 'studentClass', 'stream',
                         'targetExam', 'onboardingCompleted', 'totalTestsTaken',
                         'bestAccuracy', 'streakDays', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'subject', 'content', 'pinned',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'subject', 'content', 'pinned',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidStudyNote(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidStudyNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subject', 'content', 'pinned', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /pdfs/{pdfId} {
        allow get: if isOwner(userId) && isValidId(pdfId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(pdfId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'subject', 'uriString', 'pageCount',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'subject', 'uriString', 'pageCount',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidPdfDocument(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(pdfId) &&
                         isValidPdfDocument(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subject', 'uriString', 'pageCount', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(pdfId);
      }

      match /testAttempts/{attemptId} {
        allow get: if isOwner(userId) && isValidId(attemptId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(attemptId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'track', 'subject', 'totalQuestions',
                           'correctCount', 'score', 'maxScore', 'accuracyPercent',
                           'durationSeconds', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'track', 'subject', 'totalQuestions',
                           'correctCount', 'score', 'maxScore', 'accuracyPercent',
                           'durationSeconds', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidTestAttempt(incoming(), userId);

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(attemptId);
      }
    }
  }
}
