rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             data.selectedStream in ['10th', '11th', '12th', 'NEET', 'JEE'] &&
             data.selectedSubjectFilter is string && data.selectedSubjectFilter.size() >= 1 && data.selectedSubjectFilter.size() <= 60 &&
             data.dailyTargetLectures is int && data.dailyTargetLectures >= 1 && data.dailyTargetLectures <= 20 &&
             data.dailyTargetHours is int && data.dailyTargetHours >= 1 && data.dailyTargetHours <= 18 &&
             data.loggedHoursToday is number && data.loggedHoursToday >= 0 && data.loggedHoursToday <= 24 &&
             data.streak is int && data.streak >= 0 && data.streak <= 10000 &&
             data.alarmTone in ['neon', 'cyber', 'urgent'] &&
             data.lastLoggedDate is string && data.lastLoggedDate.size() >= 8 && data.lastLoggedDate.size() <= 20 &&
             data.isSeeded is bool;
    }

    function isValidStudyTask(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
             data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
             data.repeatCode in ['once', 'daily'] &&
             data.notes is string && data.notes.size() <= 500 &&
             data.completed is bool &&
             data.celebrated is bool &&
             data.firedKey is string && data.firedKey.size() <= 30;
    }

    function isValidChapterGoal(data, expectedUid) {
      return data.userId is string && data.userId == expectedUid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.spanLabel in ['Today', 'Tomorrow', 'Next 2 Days', 'Next 7 Days'] &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.done is bool &&
             data.celebrated is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'selectedStream', 'selectedSubjectFilter',
                         'dailyTargetLectures', 'dailyTargetHours', 'loggedHoursToday',
                         'streak', 'alarmTone', 'lastLoggedDate', 'isSeeded',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'selectedStream', 'selectedSubjectFilter',
                         'dailyTargetLectures', 'dailyTargetHours', 'loggedHoursToday',
                         'streak', 'alarmTone', 'lastLoggedDate', 'isSeeded',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'selectedStream', 'selectedSubjectFilter',
                         'dailyTargetLectures', 'dailyTargetHours', 'loggedHoursToday',
                         'streak', 'alarmTone', 'lastLoggedDate', 'isSeeded', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'subject', 'date', 'time', 'repeatCode',
                           'notes', 'completed', 'celebrated', 'firedKey', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'subject', 'date', 'time', 'repeatCode',
                           'notes', 'completed', 'celebrated', 'firedKey', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidStudyTask(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidStudyTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subject', 'date', 'time', 'repeatCode',
                           'notes', 'completed', 'celebrated', 'firedKey', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'spanLabel', 'subject',
                           'done', 'celebrated', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'spanLabel', 'subject',
                           'done', 'celebrated', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChapterGoal(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         isValidChapterGoal(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'spanLabel', 'subject', 'done', 'celebrated', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(goalId);
      }
    }
  }
}
