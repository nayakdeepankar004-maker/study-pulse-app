{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile, academic board/class/stream onboarding preferences, and exam progress stats.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning student."
        },
        "displayName": {
          "type": "string",
          "description": "Student display name."
        },
        "email": {
          "type": "string",
          "description": "Private student email address."
        },
        "board": {
          "type": "string",
          "enum": ["CBSE", "ICSE", "BSE Odisha", "Other State Boards"],
          "description": "Selected education board."
        },
        "studentClass": {
          "type": "string",
          "enum": ["Class 6", "Class 7", "Class 8", "Class 9", "Class 10", "Class 11", "Class 12"],
          "description": "Selected grade/class."
        },
        "stream": {
          "type": "string",
          "enum": ["Science PCM", "Science PCB", "Commerce", "Arts/Humanities", "Foundation"],
          "description": "Academic stream."
        },
        "targetExam": {
          "type": "string",
          "enum": ["Board Exams", "NEET", "JEE Main", "Foundation"],
          "description": "Primary target exam track."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether onboarding setup has been completed."
        },
        "totalTestsTaken": {
          "type": "integer",
          "description": "Total completed practice/mock tests."
        },
        "bestAccuracy": {
          "type": "integer",
          "description": "Highest quiz accuracy percentage (0..100)."
        },
        "streakDays": {
          "type": "integer",
          "description": "Active study streak in days."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "board",
        "studentClass",
        "stream",
        "targetExam",
        "onboardingCompleted",
        "totalTestsTaken",
        "bestAccuracy",
        "streakDays",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "User-authored study notes, formula sheets, and AI-summarized revisions.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning student."
        },
        "title": {
          "type": "string",
          "description": "Note title."
        },
        "subject": {
          "type": "string",
          "description": "Subject tag."
        },
        "content": {
          "type": "string",
          "description": "Note body text."
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether note is pinned to top."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "subject",
        "content",
        "pinned",
        "createdAt",
        "updatedAt"
      ]
    },
    "PdfDocumentMeta": {
      "title": "PdfDocumentMeta",
      "description": "Metadata and SAF content URI reference for a student's study PDF.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning student."
        },
        "title": {
          "type": "string",
          "description": "Display title of the PDF."
        },
        "subject": {
          "type": "string",
          "description": "Subject category."
        },
        "uriString": {
          "type": "string",
          "description": "Persistable SAF URI string on device."
        },
        "pageCount": {
          "type": "integer",
          "description": "Number of pages in the PDF."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "subject",
        "uriString",
        "pageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "TestAttempt": {
      "title": "TestAttempt",
      "description": "Completed practice quiz or mock exam result.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning student."
        },
        "title": {
          "type": "string",
          "description": "Quiz or mock test title."
        },
        "track": {
          "type": "string",
          "enum": ["Board Exams", "NEET", "JEE Main", "Foundation", "AI Generated"],
          "description": "Exam track."
        },
        "subject": {
          "type": "string",
          "description": "Subject tested."
        },
        "totalQuestions": {
          "type": "integer",
          "description": "Total questions in test."
        },
        "correctCount": {
          "type": "integer",
          "description": "Correctly answered questions."
        },
        "score": {
          "type": "integer",
          "description": "Score achieved."
        },
        "maxScore": {
          "type": "integer",
          "description": "Maximum possible score."
        },
        "accuracyPercent": {
          "type": "integer",
          "description": "Accuracy percentage (0..100)."
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Time spent in seconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "track",
        "subject",
        "totalQuestions",
        "correctCount",
        "score",
        "maxScore",
        "accuracyPercent",
        "durationSeconds",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private student profile, academic setup, and aggregate quiz metrics."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/StudyNote"
      },
      "description": "Student-owned study notes."
    },
    "/users/{userId}/pdfs/{pdfId}": {
      "schema": {
        "$ref": "#/entities/PdfDocumentMeta"
      },
      "description": "Student-owned PDF library metadata."
    },
    "/users/{userId}/testAttempts/{attemptId}": {
      "schema": {
        "$ref": "#/entities/TestAttempt"
      },
      "description": "Student-owned practice & mock test history."
    }
  }
}
